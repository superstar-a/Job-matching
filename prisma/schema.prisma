// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// 1. Users Table
model User {
  userID        String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @map("UserID") @db.UniqueIdentifier
  email         String   @unique(map: "UQ_Users_Email") @map("Email") @db.NVarChar(255)
  username      String   @unique(map: "UQ_Users_Username") @map("Username") @db.NVarChar(100)
  accountStatus String   @default("Active") @map("AccountStatus") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("CreatedAt") @db.DateTime2
  updatedAt     DateTime @default(now()) @updatedAt @map("UpdatedAt") @db.DateTime2

  credentials Credential[]
  userRoles   UserRole[]
  sessions    Session[]
  auditLogs   SecurityAuditLog[]

  @@map("Users")
}

// 2. Credentials Table
model Credential {
  credentialID String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @map("CredentialID") @db.UniqueIdentifier
  userID       String   @map("UserID") @db.UniqueIdentifier
  authProvider String   @default("Local") @map("AuthProvider") @db.VarChar(50)
  providerKey  String?  @map("ProviderKey") @db.VarChar(255)
  passwordHash String?  @map("PasswordHash") @db.VarChar(255)
  passwordSalt String?  @map("PasswordSalt") @db.VarChar(255)
  lastUpdated  DateTime @default(now()) @map("LastUpdated") @db.DateTime2

  user User @relation(fields: [userID], references: [userID], onDelete: Cascade, map: "FK_Credentials_Users")

  @@unique([userID, authProvider], map: "UQ_Credentials_UserProvider")
  @@map("Credentials")
}

// 3. Roles Table
model Role {
  roleID      Int     @id @default(autoincrement()) @map("RoleID")
  roleName    String  @unique(map: "UQ_Roles_RoleName") @map("RoleName") @db.VarChar(50)
  description String? @map("Description") @db.NVarChar(255)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("Roles")
}

// 4. Permissions Table
model Permission {
  permissionID   Int     @id @default(autoincrement()) @map("PermissionID")
  permissionName String  @unique(map: "UQ_Permissions_PermissionName") @map("PermissionName") @db.VarChar(100)
  description    String? @map("Description") @db.NVarChar(255)

  rolePermissions RolePermission[]

  @@map("Permissions")
}

// 5. RolePermissions Mapping
model RolePermission {
  roleID       Int @map("RoleID")
  permissionID Int @map("PermissionID")

  role       Role       @relation(fields: [roleID], references: [roleID], onDelete: Cascade, map: "FK_RolePermissions_Roles")
  permission Permission @relation(fields: [permissionID], references: [permissionID], onDelete: Cascade, map: "FK_RolePermissions_Permissions")

  @@id([roleID, permissionID])
  @@map("RolePermissions")
}

// 6. UserRoles Mapping
model UserRole {
  userID     String   @map("UserID") @db.UniqueIdentifier
  roleID     Int      @map("RoleID")
  assignedAt DateTime @default(now()) @map("AssignedAt") @db.DateTime2

  user User @relation(fields: [userID], references: [userID], onDelete: Cascade, map: "FK_UserRoles_Users")
  role Role @relation(fields: [roleID], references: [roleID], onDelete: Cascade, map: "FK_UserRoles_Roles")

  @@id([userID, roleID])
  @@map("UserRoles")
}

// 7. Sessions Table
model Session {
  sessionID    String   @id @default(dbgenerated("NEWSEQUENTIALID()")) @map("SessionID") @db.UniqueIdentifier
  userID       String   @map("UserID") @db.UniqueIdentifier
  refreshToken String   @map("RefreshToken") @db.VarChar(512)
  ipAddress    String?  @map("IPAddress") @db.VarChar(45)
  userAgent    String?  @map("UserAgent") @db.NVarChar(500)
  isRevoked    Boolean  @default(false) @map("IsRevoked")
  expiresAt    DateTime @map("ExpiresAt") @db.DateTime2
  createdAt    DateTime @default(now()) @map("CreatedAt") @db.DateTime2

  user User @relation(fields: [userID], references: [userID], onDelete: Cascade, map: "FK_Sessions_Users")

  @@map("Sessions")
}

// 8. Audit Trails (Security Logs)
model SecurityAuditLog {
  logID        BigInt   @id @default(autoincrement()) @map("LogID")
  userID       String?  @map("UserID") @db.UniqueIdentifier
  eventType    String   @map("EventType") @db.VarChar(50)
  ipAddress    String?  @map("IPAddress") @db.VarChar(45)
  eventDetails String?  @map("EventDetails") @db.NVarChar(Max)
  createdAt    DateTime @default(now()) @map("CreatedAt") @db.DateTime2

  user User? @relation(fields: [userID], references: [userID], onDelete: SetNull)

  @@map("SecurityAuditLogs")
}