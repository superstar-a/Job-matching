# Environment template for Job-matching Monorepo
NODE_ENV=development
PORT=3000
FRONTEND_PORT=3000
BACKEND_PORT=4000
AI_SERVICE_PORT=8000

# Database Configuration (MS SQL Server)
# Port 1434 on host to avoid conflict with local SQL Server on 1433
DB_PORT=1434
DB_NAME=job_matching_db
DB_USER=sa
DB_PASSWORD=YourPassword123!

# JWT Authentication Secret
JWT_SECRET=local-dev-secret-key-change-in-production

# AWS Service Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=job-matching-cv-bucket
